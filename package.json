{
  "name": "sameer-cloud-taskmanager",
  "private": true,
  "version": "1.0.0",
  "description": "A clean, self-hostable, open-source task manager: kanban board, list view, due dates, priorities, labels and a simple password gate.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "hash-password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
